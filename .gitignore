# Byte-compiled
__pycache__/
*.py[cod]
*.pyo

# PyInstaller build output
build/
dist/
*.manifest

# Scraped lead data — real provider contact details. These are working files,
# not source, and must never be pushed to a public repo.
*.xlsx
*.ods
*.db
*.db-journal
*.db-wal
*.db-shm
leads.db*

# Local settings: proxy, Google service-account path, worker counts.
config.json
# The user's lead-type definitions, and copies set aside when unreadable.
lead_types.json
lead_types.json.bad*
# Google service-account credentials
*-service-account.json
credentials.json

# Run logs
logs/
*.log

# What this machine's network allows (DNS, port 25), remembered between runs.
.cache/

# Test/scratch
.pytest_cache/
.coverage
htmlcov/

# LibreOffice/Excel lock files, left while a workbook is open.
.~lock.*#
~$*
